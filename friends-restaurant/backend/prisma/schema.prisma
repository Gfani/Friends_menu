generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String   @default("Manager")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id             String     @id @default(uuid())
  name           String     @unique
  slug           String     @unique
  description    String?
  parentCategory String     @default("FOOD") // "FOOD" | "DRINKS"
  sortOrder      Int        @default(0)
  icon           String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  items          MenuItem[]
}

model MenuItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float?
  image       String?
  isAvailable Boolean  @default(true)
  tags        String?
  sortOrder   Int      @default(0)
  viewsCount  Int      @default(0)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnalyticsEvent {
  id          String   @id @default(uuid())
  type        String   // "PAGE_VIEW" | "TABLE_SCAN" | "ITEM_VIEW"
  tableNumber String?
  itemId      String?
  itemName    String?
  createdAt   DateTime @default(now())
}

model ServiceRequest {
  id            String   @id @default(uuid())
  tableNumber   String
  type          String   // "CALL_WAITER" | "REQUEST_BILL"
  paymentMethod String?
  notes         String?
  status        String   @default("PENDING") // "PENDING" | "COMPLETED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SiteSetting {
  id                    String   @id @default("default")
  restaurantName        String   @default("MEREBA FRIENDS GARDEN")
  tagline               String   @default("BISTRO • GARDEN • CASUAL LUXURY")
  heroTitle1            String   @default("THE ONE WITH")
  heroTitle2            String   @default("THE FOOD")
  heroDescription       String   @default("Good food, great company, and timeless memories. Browse our hand-rolled pastas, hearty pilafs, fresh garden bowls, and slow-simmered broths.")
  primaryCtaText        String   @default("EXPLORE OUR MENU")
  secondaryCtaText      String   @default("VISIT OUR GARDEN")

  wifiSsid              String   @default("Mereba_Friends_Garden_5G")
  wifiPassword          String   @default("centralperkcoffee")

  philosophyEyebrow     String   @default("Our Philosophy")
  philosophyTitle       String   @default("MORE THAN FOOD. IT'S ABOUT FRIENDSHIP.")
  philosophyDescription String   @default("Central Perk meets modern boutique lounge. Designed as a sanctuary for heartfelt conversations, spontaneous laughter, and unforgettable comfort food in our garden.")
  manifestoQuote        String   @default("Because Joey doesn’t share food, but we definitely think you should.")
  manifestoAuthor       String   @default("The Kitchen Manifesto")

  galleryTitle          String   @default("THE ONE WITH THE GOOD TIMES")
  galleryDescription    String   @default("A glimpse into our candlelit tables, laughter-filled dinners, and passionate artisan cooking in Mereba Friends Garden.")

  addressLine1          String   @default("17 ቀበሌ፣ ፊትለፊት በሰበርደ")
  addressLine2          String   @default("ናይቀደም ገዛ ተጋሩ")
  openingHours          String   @default("11:00 AM – 11:00 PM")
  phone1                String   @default("0970700488")
  phone2                String   @default("0945986349")
  instagramHandle       String   @default("@MEREBA_FRIENDS_GARDEN")
  instagramUrl          String   @default("https://www.instagram.com/mereba_friends_garden/")
  tiktokHandle          String   @default("@FRIENDS_GARDEN")
  tiktokUrl             String   @default("https://www.tiktok.com/@friends_garden")
  facebookHandle        String   @default("FB: FRIENDS GARDEN - መረባ ፍሬንድስ")
  facebookUrl           String   @default("https://www.facebook.com/search/top?q=FRIENDS%20GARDEN%20-%20%E1%88%98%E1%88%A8%E1%89%A3%20%E1%87%8D%E1%88%AC%E1%8A%95%E1%8B%95%E1%88%B5")

  accentColor           String   @default("#FFBD18")
  backgroundColor       String   @default("#050505")
  cardColor             String   @default("#121212")
  fontFamily            String   @default("Plus Jakarta Sans")

  updatedAt             DateTime @updatedAt
}
